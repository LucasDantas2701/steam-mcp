# Copie para .env e preencha (Supabase: Project Settings -> API Keys / Data API).
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA (anon / publishable). É a que o servidor MCP usa; só consegue LER (RLS).
# Configure esta mesma variável na Vercel.
SUPABASE_KEY=

# Chave SECRETA (service_role / secret). Só para o scripts/seed.py, na sua máquina.
# NUNCA coloque na Vercel nem faça commit.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional, para o agente LangChain:
# MODELO=openai:gpt-4.1
# OPENAI_API_KEY=
# MCP_URL=https://SEU-PROJETO.vercel.app/mcp
